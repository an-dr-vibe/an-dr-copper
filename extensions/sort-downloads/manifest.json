{
  "$schema": "https://Copper.dev/schemas/extension/1.0.0/descriptor.schema.json",
  "id": "sort-downloads",
  "name": "Sort Downloads",
  "version": "1.0.0",
  "trigger": "sort-dl",
  "runtime": {
    "kind": "wasm-component",
    "abi": "copper.component/1",
    "artifact": "sort-downloads.wasm"
  },
  "permissions": ["fs", "ui"],
  "inputs": [
    {
      "id": "folder",
      "type": "folder-picker",
      "label": "Target folder",
      "default": "~/Downloads"
    }
  ],
  "actions": [
    {
      "id": "sort",
      "label": "Sort by extension",
      "script": "sort"
    }
  ],
  "ui": {
    "type": "toast"
  }
}
