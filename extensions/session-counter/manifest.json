{
  "$schema": "https://Copper.dev/schemas/extension/1.0.0/descriptor.schema.json",
  "id": "session-counter",
  "name": "Session Counter",
  "version": "1.0.0",
  "trigger": "session-count",
  "runtime": {
    "kind": "wasm-component",
    "abi": "copper.component/1",
    "artifact": "session-counter.wasm"
  },
  "permissions": ["store", "ui"],
  "actions": [
    {
      "id": "increment",
      "label": "Increment session counter",
      "script": "increment"
    }
  ],
  "ui": {
    "type": "toast"
  }
}
